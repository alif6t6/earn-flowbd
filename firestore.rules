rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default: denies read/write access to all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection: users can read and update their own document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // User subcollections (e.g., transactions, tasks, earnings)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public / App Settings Collection (read-only for users, write for admin)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }
  }
}
