rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Tasks & Videos Collection
    match /tasks/{taskId} {
      allow read, create, update, delete: if true;
    }

    // Withdrawals Collection
    match /withdrawals/{withdrawalId} {
      allow read, create, update, delete: if true;
    }

    // Settings Collection
    match /settings/{docId} {
      allow read, create, update, delete: if true;
    }

    // Advertisements Collection
    match /advertisements/{adId} {
      allow read, create, update, delete: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, create, update, delete: if true;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read, create, update, delete: if true;
    }

    // Promo Codes Collection
    match /promoCodes/{codeId} {
      allow read, create, update, delete: if true;
    }

    match /userPromoCodes/{id} {
      allow read, create, update, delete: if true;
    }

    // Premium Requests Collection
    match /premiumRequests/{requestId} {
      allow read, create, update, delete: if true;
    }
  }
}
